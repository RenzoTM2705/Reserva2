# ============================================================
# Variables del repositorio (raíz) — NO se exponen al cliente
# ============================================================
# Solo las usa la CLI de Supabase y los scripts locales.
# Copiar a `.env` (raíz) y completar. `.env` está ignorado por Git.
#
# NUNCA usar la service_role key en el navegador: omite RLS.
# ============================================================

# Personal Access Token de Supabase (https://supabase.com/dashboard/account/tokens)
# Necesario para `supabase login`, `db push` y `gen types`.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identificador del proyecto (subdominio del dashboard)
SUPABASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxx

# Contraseña de la base de datos (solo para operaciones de CLI/psql)
SUPABASE_DB_PASSWORD=change-me

# Conexión directa (opcional, para psql o migraciones manuales)
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
